# Payload CMS Secret (generate a random string for production)
PAYLOAD_SECRET=your-payload-secret-change-in-production

# R2 Storage (CloudFlare)
NEXT_PUBLIC_R2_PUBLIC_URL=https://your-r2-public-url.r2.dev
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=ballade

# Turso Database
TURSO_DB_URL=libsql://your-database.turso.io
TURSO_DB_TOKEN=your-turso-auth-token
